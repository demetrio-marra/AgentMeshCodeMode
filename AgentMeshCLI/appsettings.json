{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "User": {
    "AgentId": "User"
  },
  "ApiDocumentationMongoRepository": {
    "ConnectionString": "mongodb://AgentMeshUser:StrongPassword123@localhost:62222/?authSource=AgentMesh&authMechanism=SCRAM-SHA-256",
    "DatabaseName": "AgentMesh",
    "CollectionName": "ApiDocumentation"
  },
  "QDrantSemanticSearchService": {
    "Host": "qdrant.dem-k8s.home",
    "Port": 443,
    "Https": true,
    "VectorSize": 4096,
    "MaxResults": 10,
    "BusinessProcessesCollectionName": "BusinessProcesses"
  },
  "SESJSSandbox": {
    "SandboxServiceURL": "https://jscodesandbox.dem-k8s.home",
    "SandboxName": "Statistics"
  },
  "InferenceProviders": {
    "HuggingFace": {
      "Endpoint": "https://router.huggingface.co/v1",
      "ApiKey": "<your api key here>"
    },
    "Together": {
      "Endpoint": "https://api.together.xyz/v1/",
      "ApiKey": "<your api key here>"
    },
    "FireworksAI": {
      "Endpoint": "https://api.fireworks.ai/inference/v1/",
      "ApiKey": "<your api key here>"
    }
  },
  "Embedding": {
    "ModelEndpoint": "https://router.huggingface.co/scaleway/v1/embeddings",
    "ModelName": "qwen3-embedding-8b",
    "ApiKey": "<your api key here>"
  },
  "LLMs": {
    "ContextAnalyzerLLM": {
      "CostPerMillionInputTokens": "0.05",
      "CostPerMillionOutputTokens": "0.20",
      "Model": "openai/gpt-oss-20b",
      "Provider": "Together"
    },
    "CoderLLM": {
      "CostPerMillionInputTokens": "0.04",
      "CostPerMillionOutputTokens": "0.15",
      "Model": "openai/gpt-oss-20b:novita",
      "Provider": "HuggingFace"
    },
    "20B-Class-LLM": {
      "CostPerMillionInputTokens": "0.04",
      "CostPerMillionOutputTokens": "0.15",
      "Model": "openai/gpt-oss-20b:novita",
      "Provider": "HuggingFace"
    },
    "8B-Class-LLM": {
      "CostPerMillionInputTokens": "0.02",
      "CostPerMillionOutputTokens": "0.05",
      "Model": "meta-llama/Llama-3.1-8B-Instruct:novita",
      "Provider": "HuggingFace"
    },
    "3B-Class-LLM": {
      "CostPerMillionInputTokens": "0.02",
      "CostPerMillionOutputTokens": "0.04",
      "Model": "google/gemma-3n-E4B-it",
      "Provider": "Together"
    }
  },
  "Agents": {
    "BusinessRequirementsCreator": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/BusinessRequirementsCreator.SystemPrompt.txt"
    },
    "BusinessAdvisor": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/BusinessAdvisor.SystemPrompt.txt"
    },
    "Coder": {
      "LLM": "CoderLLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/Coder.SystemPrompt.txt",
      "ApiReferenceFile": "Prompts/MyPlatform_Statistics/ApiReference.txt"
    },
    "ResultsPresenter": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/ResultsPresenter.SystemPrompt.txt"
    },
    "CodeFixer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/CodeFixer.SystemPrompt.txt"
    },
    "CodeExecutionFailuresDetector": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/CodeExecutionFailuresDetector.SystemPrompt.txt"
    },
    "CodeStaticAnalyzer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/CodeStaticAnalyzer.SystemPrompt.txt"
    },
    "ContextAnalyzer": {
      "LLM": "ContextAnalyzerLLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/ContextAnalyzer.SystemPrompt.txt"
    },
    "Router": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/Router.SystemPrompt.txt",
      "AllowedRecipients": [
        "BusinessRequirementsCreator",
        "BusinessAdvisor",
        "PersonalAssistant"
      ]
    },
    "PersonalAssistant": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.7",
      "SystemPromptFile": "Prompts/PersonalAssistant.SystemPrompt.txt"
    },
    "ConversationSummarizer": {
      "LLM": "20B-Class-LLM",
      "ModelTemperature": "0.6",
      "SystemPromptFile": "Prompts/ConversationSummarizer.SystemPrompt.txt",
      "SummaryTokenThreshold": 4000,
      "NumMessageToPreseve": 12,
      "SummarizeLanguage": "Italian"
    }
  }
}
